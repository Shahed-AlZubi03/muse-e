# ── Database ──────────────────────────────────────────────────────────────────
# For Docker Compose (local Mongo container):
MONGODB_URI=mongodb://mongo:27017/museum-guide
# For MongoDB Atlas (replace with your Atlas connection string):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/museum-guide?retryWrites=true&w=majority

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be a long, random string — e.g. openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── TTS (optional) ────────────────────────────────────────────────────────────
# Options: alloy | echo | fable | onyx | nova | shimmer
TTS_VOICE=nova

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Set to the frontend origin if hosted separately; leave unset for same-origin.
# CORS_ORIGIN=https://your-frontend-domain.com
